{
  "name": "atslang",
  "displayName": "ATSLang",
  "description": "Türkçe programlama dili ATSLang için renklendirme, otomatik tamamlama ve kod kalıpları",
  "version": "0.7.3",
  "publisher": "AtsCreativeMedia",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/DEVEymen/ATSLang#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEVEymen/ATSLang.git"
  },
  "bugs": {
    "url": "https://github.com/DEVEymen/ATSLang/issues"
  },
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "keywords": [
    "atslang",
    "türkçe",
    "turkish",
    "programlama dili",
    "programming language",
    "eğitim"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "atslang",
        "aliases": [
          "ATSLang",
          "atslang"
        ],
        "extensions": [
          ".atslang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "atslang",
        "scopeName": "source.atslang",
        "path": "./syntaxes/atslang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "atslang",
        "path": "./snippets/atslang.json"
      }
    ],
    "configurationDefaults": {
      "[atslang]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.snippetSuggestions": "top",
        "editor.wordBasedSuggestions": "matchingDocuments"
      }
    }
  }
}